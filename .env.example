# System Environment & Mode
NODE_ENV=development                    # development | production | test
MODE=presentation                       # presentation | cloud

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Authentication & JWT
JWT_SECRET=dfus-default-jwt-secret-change-in-production-key-32ch
JWT_EXPIRES_IN=24h
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRST_USER_ADMIN=true                   # First registered user gets admin role

# Master Server
MASTER_PORT=3000                        # Master HTTP port
MASTER_HOST=localhost                   # Master hostname

# Workers
WORKER_COUNT=3                          # Number of worker nodes to spawn
WORKER_BASE_PORT=4001                   # First worker's port (increments: 4001, 4002, ...)
WORKER_SECRET=your-shared-secret        # Pre-shared secret for worker auth

# Storage Quotas
DEFAULT_STORAGE_QUOTA=1073741824        # Default per-user quota in bytes (1GB)
CHUNK_SIZE_BYTES=2097152                # Chunk size in bytes (2MB)

# Replication & Heartbeat
REPLICATION_FACTOR=2                    # Number of copies per chunk
HEARTBEAT_INTERVAL_MS=5000              # Heartbeat ping interval
MAX_MISSED_BEATS=3                      # Missed heartbeats before worker is dead
REPLICATION_CONCURRENCY=5               # Max concurrent replication transfers

# SQLite (Presentation Mode)
SQLITE_DB_PATH=./data/db/distributed_storage.db

# MongoDB Atlas (Cloud Mode)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dfs

# Cloudflare R2 (Cloud Mode)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=dfs-chunks

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000             # 15 minutes
RATE_LIMIT_MAX=200                      # Max requests per window
AUTH_RATE_LIMIT_MAX=10                  # Max auth attempts per window

# Logging
LOG_LEVEL=info                          # error, warn, info, http, debug

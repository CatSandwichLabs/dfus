{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/metrics",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/system/cron/heartbeat",
      "schedule": "* * * * *"
    }
  ]
}
